# Copy to .env. Never commit .env.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Local (non-Docker) runs. Docker Compose sets these automatically.
SOURCE_DB_URL=postgresql://postgres:change-me@localhost:5432/retail_source
WAREHOUSE_DB_URL=postgresql://postgres:change-me@localhost:5432/retail_dw
LAKE_ROOT=./lake
LANDING_ROOT=./data/landing

SPARK_MASTER=local[2]
SPARK_DRIVER_MEMORY=1g
MAX_QUARANTINE_RATIO=0.05
# PySpark 4 needs Java 17+. Set if java is not already on PATH:
# JAVA_HOME=/path/to/jdk-17
